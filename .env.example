# ============================================================
# Environment Variables Configuration Template
# Robust Deepfake Detection - Authentication & Database
# ============================================================

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://localhost:27017
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=deepfake_detection_db

# JWT Access Token Secret (Change in production!)
JWT_SECRET_KEY=deepguard-secure-auth-secret-key-32-bytes-minimum-robust-deepfake-detection
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cookie Settings
COOKIE_SECURE=false
